# Application Configuration
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Secrets
SESSION_SECRET=dev-secret-key-must-be-at-least-32-chars-long
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://ucs_user:ucs_password@localhost:5433/ucs_cm_db

# Query & Lock Timeout Governance
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_LOCK_TIMEOUT_MS=5000

# Document Storage Driver Setup
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
